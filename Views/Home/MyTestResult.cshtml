<div class="mt-5 container">
    <div class="row mb-5">
        <div class="col-sm-6">
            <h1>Mireseerdhe @ViewBag.thispacient.Emripacientit</h1>
        </div>
        <div class="offset-sm-4 col-sm-2">
            <a class="btn btn-danger" asp-action="LogOut" asp-controller="Home">Log Out</a>
        </div>
    </div>

    <div class="row">
        <!-- Chat Window (Left Side, bigger now) -->
        <div class="col-sm-5">
            <div class="card shadow-lg" style="height: 600px; display: flex; flex-direction: column;">
                <div class="card-header bg-primary text-white">
                    <strong>AI Chat Assistant</strong>
                </div>
                <div id="chatWindow" class="card-body overflow-auto" style="flex: 1; max-height: 500px;">
                    <!-- Messages will be added here dynamically -->
                </div>
                <div class="card-footer">
                    <form id="chatForm" class="d-flex">
                        <input type="text" id="chatInput" class="form-control me-2" placeholder="Type your message..." required />
                        <button type="submit" class="btn btn-primary">Send</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Patient Results (Right Side, smaller now) -->
        <div class="col-sm-7">
            <form id="testSelectionForm">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">Select</th>
                            <th scope="col">Emri Analizes</th>
                            <th scope="col">Data</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewBag.thispacient.MYfleteanaliz)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="selectedTests" value="@item.FleteAnalizeId" />
                                </td>
                                <td>
                                    <a asp-action="printo" asp-route-id2="@item.FleteAnalizeId">@item.Emri</a>
                                </td>
                                <td>@item.CreatedAt</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button type="button" id="analyzeBtn" class="btn btn-success">Analyze Selected</button>
            </form>
        </div>
    </div>
</div>

