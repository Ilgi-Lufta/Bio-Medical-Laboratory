    <script>
        // Helper: show loader
        function showLoader(chatWindow) {
            const loaderId = "loader-" + Date.now();
            chatWindow.innerHTML += `
                <div id="${loaderId}" class="mb-2">
                    <strong>AI:</strong>
                    <div class="p-2 bg-light rounded mt-1">
                        <span class="loader"></span> Thinking...
                    </div>
                </div>`;
            chatWindow.scrollTop = chatWindow.scrollHeight;
            return loaderId;
        }

        // Helper: replace loader with AI response
        function replaceLoaderWithReply(loaderId, reply) {
            const loaderDiv = document.getElementById(loaderId);
            if (loaderDiv) {
                loaderDiv.innerHTML = `
                    <strong>AI:</strong>
                    <div class="p-2 bg-light rounded mt-1">
                        ${marked.parse(reply)}
                    </div>`;
            }
        }

        // Send chat message
        document.getElementById("chatForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const input = document.getElementById("chatInput");
            const message = input.value;
            input.value = "";

            const chatWindow = document.getElementById("chatWindow");
            chatWindow.innerHTML += `<div><strong>You:</strong> ${message}</div>`;
            const loaderId = showLoader(chatWindow);

            const response = await fetch('/Home/SendChatMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: message })
            });

            if (response.ok) {
                const data = await response.json();
                replaceLoaderWithReply(loaderId, data.reply);
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }
        });

        // Analyze selected test results
        document.getElementById("analyzeBtn").addEventListener("click", async function () {
            const selected = [...document.querySelectorAll('input[name="selectedTests"]:checked')]
                .map(cb => cb.value);

            if (selected.length === 0) {
                alert("Please select at least one test result.");
                return;
            }

            const chatWindow = document.getElementById("chatWindow");
            chatWindow.innerHTML += `<div><strong>You:</strong> Analyze selected tests (${selected.join(", ")})</div>`;
            const loaderId = showLoader(chatWindow);

            const response = await fetch('/Home/AnalyzeTests', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ testIds: selected })
            });

            if (response.ok) {
                const data = await response.json();
                replaceLoaderWithReply(loaderId, data.reply);
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }
        });
    </script>

}
